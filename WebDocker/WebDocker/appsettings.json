{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=DataBase/WebDocker.db"
  },

  "Jwt": {
    "Issuer": "WebDocker",
    "Audience": "WebDockerClients",
    "Key": "DevKeyCambiarEnProduccionMinimo32CaracteresAleatorios",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7163",
      "http://localhost:5072",
      "http://51.170.39.109:8080"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/WebDocker_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 5
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }


}
