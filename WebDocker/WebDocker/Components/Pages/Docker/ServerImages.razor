@page "/docker/server/images/{ServerId:int}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@using global::Docker.DotNet.Models
@using WebDocker.Data
@using WebDocker.Services

@attribute [Authorize]
@rendermode InteractiveServer

@inject ServerService ServerService
@inject DockerService DockerService

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IDialogService DialogService

<PageTitle>Imágenes - @(server?.Name ?? "Servidor")</PageTitle>

<div class="container-fluid px-4 py-3">


    <!-- Botón Volver -->
    <!-- ---------------------------------------------------------------------------------------------------------------------------------------- -->
    <div class="mb-3">
        <FluentButton Appearance="Appearance.Stealth" OnClick="@GoBack">
            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())" Slot="start" />
            Volver al Servidor
        </FluentButton>
    </div>

    <hr />


    <!-- Imagenes -->
    <!-- ---------------------------------------------------------------------------------------------------------------------------------------- -->
    @if (isLoading)
    {
        <FluentProgressRing />
    }
    else if (server == null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">
            Servidor no encontrado o sin permisos.
        </FluentMessageBar>
    }
    else
    {
        <h2>Imágenes de @server.Name</h2>

        <!-- Botones de acciones imagenes -->
        <!-- ---------------------------------------------------------------------------------------------------------------------------------------- -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 style="color:var(--acento-oscuro); margin:0;">
                <FluentIcon Value="@(new Icons.Regular.Size24.BoxMultiple())" Style="margin-right:6px;" />
                Imagenes (@(images?.Count ?? 0))
            </h4>
            <div class="d-flex gap-2">
                <FluentButton Appearance="Appearance.Outline" OnClick="@RefreshImages" Loading="@isRefreshing">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSync())" Slot="start" />
                    Refrescar
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="@NewImage" Disabled="@(!isConnected || !_canWrite)">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Slot="start" Color="Color.Custom" CustomColor="#FFFFFF" />
                    Nueva Imagen
                </FluentButton>
            </div>
        </div>


        <!-- Crear imagenes -->
        <!-- ---------------------------------------------------------------------------------------------------------------------------------------- -->
        @if (IsOnNewImage)
        {
            <FluentCard Style="margin-bottom:16px; border: 2px solid var(--Amarillo);">
                <h5 style="color:var(--Dark-Amarillo); margin-bottom:12px;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Style="margin-right:6px;" />
                    Crear nueva imagen (Docker Hub)
                </h5>

                <!-- Descargar desde repositorio. -->
                <FluentCard Style="margin-bottom:16px; border: 2px solid var(--accent-one);">
                    <h5 style="color:var(--Dark-Amarillo); margin-bottom:12px;">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Style="margin-right:6px;" />
                        Descargar imagen 
                    </h5>

                    <div class="d-flex gap-2 my-3">
                        <FluentTextField @bind-Value="pullImageName" Placeholder="imagen:tag (ej. nginx:latest)" />
                        <FluentButton Appearance="Appearance.Accent" OnClick="@PullImage" Disabled="@(isPulling || !_canWrite)">
                            @(isPulling ? "Descargando..." : "Descargar imagen")
                        </FluentButton>
                    </div>
                </FluentCard>

               <!-- Cargar imagen desde un fichero .tar (equivalente a 'docker load'). -->
               <FluentCard Style="margin-bottom:16px; border: 2px solid var(--accent-two);">
                    <h5 style="color:var(--Dark-Amarillo); margin-bottom:12px;">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Style="margin-right:6px;" />
                        Cargar imagen desde fichero .tar
                    </h5>

                    <div class="d-flex gap-2 my-3 align-items-center">
                        <label class="fw-bold mb-0">Cargar desde .tar:</label>
                        <InputFile OnChange="@OnTarSelected" accept=".tar" disabled="@(isLoadingTar || !_canWrite)" />
                        @if (isLoadingTar)
                        {
                            <FluentProgressRing style="width:20px; height:20px;" />
                            <span class="text-muted">Cargando imagen...</span>
                        }
                    </div>
                </FluentCard>


                <!-- Build image -->
                <FluentCard Style="margin-bottom:16px; border: 2px solid var(--accent-four);">
                    <h5 style="color:var(--Dark-Amarillo); margin-bottom:12px;">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Style="margin-right:6px;" />
                        Generar imagen
                    </h5>

                </FluentCard>




                @*             <EditForm Model="@newContainer" OnValidSubmit="@CreateContainer">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Nombre del contenedor</label>
                        <FluentTextField @bind-Value="newContainer.Name" Placeholder="mi-contenedor" Style="width:100%;" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Imagen</label>
                        <FluentTextField @bind-Value="newContainer.Image" Placeholder="nginx:latest" Style="width:100%;" />
                        <ValidationMessage For="@(() => newContainer.Image)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Puertos (host:container)</label>
                        <FluentTextField @bind-Value="newContainer.Ports" Placeholder="8080:80, 443:443" Style="width:100%;" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Variables de entorno (KEY=VALUE, una por línea)</label>
                        <div @onkeydown:stopPropagation="true">
                            <FluentTextArea @bind-Value="newContainer.EnvVars" Placeholder="MYSQL_ROOT_PASSWORD=secret&#10;MYSQL_DATABASE=mydb" Rows="3"  Style="width:100%;" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Comando (opcional)</label>
                        <FluentTextField @bind-Value="newContainer.Command" Placeholder="/bin/bash" Style="width:100%;" />
                        <div class="mt-2">
                            <FluentCheckbox @bind-Value="newContainer.AutoStart" Label="Iniciar automáticamente tras crear" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Loading="@isCreating" Disabled="@(isCreating || !_canContainersWrite)">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Play())" Slot="start" Color="Color.Custom" CustomColor="#FFFFFF" />
