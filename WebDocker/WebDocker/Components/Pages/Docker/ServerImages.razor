                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth" OnClick="@CancelNewContainer">
                        Cancelar
                    </FluentButton>
                </div>
            </EditForm> *@

                <FluentButton Appearance="Appearance.Stealth" OnClick="@CancelNewImage">
                    Cancelar
                </FluentButton>
            </FluentCard>
        }


        <!-- Grid de Imagenes -->
        <!-- ---------------------------------------------------------------------------------------------------------------------------------------- -->
        @if (images?.Count == 0)
        {
            <FluentMessageBar Intent="MessageIntent.Info">No hay imágenes.</FluentMessageBar>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Tags</th>
                        <th>ID</th>
                        <th>Tamaño</th>
                        <th>Creada</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var img in images!)
                    {
                        <tr>
                            <td>@(img.RepoTags != null && img.RepoTags.Count > 0 ? string.Join(", ", img.RepoTags) : "<sin tag>")</td>
                            <td><small>@ShortId(img.ID)</small></td>
                            <td>@FormatSize(img.Size)</td>
                            <td>@img.Created.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Outline" Title="Eliminar" 
                                    OnClick="@(() => DeleteImage(img.ID))" Disabled="@(!_canWrite)">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                                </FluentButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter] public int ServerId { get; set; }

    private DockerServer? server;
    private IList<ImagesListResponse> images = new List<ImagesListResponse>();

    private bool isLoading = true;
    private string? authUserId;
    private bool _canWrite;
    private bool isConnected = false;

    private bool isPulling = false;
    private string pullImageName = string.Empty;

    private bool isLoadingTar = false;


    private void GoBack() => Navigation.NavigateTo($"/docker/serverdetail/{ServerId}");


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        authUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _canWrite = authState.User.HasPermission("images.write");

        if (authUserId == null)
        {
            Navigation.NavigateTo("/Account/Login");
            return;
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            server = await ServerService.GetServerById(ServerId, authUserId!);
            if (server != null)
            {
                images = await LoadImages();
            }
            isLoading = false;
            StateHasChanged();
        }

    }

    private async Task<IList<ImagesListResponse>> LoadImages()
    {
        IList<ImagesListResponse> images = null!;

        if (server != null)
        {
            var (success, message) = await DockerService.TestConnection(server);
            isConnected = success;

            if (isConnected)
            {
                images = await DockerService.GetImages(server);
            }
        }

        return images;
    }

    // ----------------------------------------------------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------------------------------------------------
    private bool isRefreshing = false;

    private async Task RefreshImages()
    {
        isRefreshing = true;
        StateHasChanged();

        images = await LoadImages();

        isRefreshing = false;
        StateHasChanged();
    }

    // ----------------------------------------------------------------------------------------------------------------------------------------------
    // Nueva Imagen
    // ----------------------------------------------------------------------------------------------------------------------------------------------
    private object newImage = new();
    private bool IsOnNewImage = false;
    private bool isCreating = false;

    private void NewImage()
    {
        newImage = new object(); // new ContainerView();
        IsOnNewImage = true;
        isCreating = false;
        StateHasChanged();
    }

    private async Task CreateImage()
    {
        if (!_canWrite) { ToastService.ShowError("No tienes permiso para esta acción."); return; }
        if (server == null) return;

        isCreating = true;
        StateHasChanged();

        // var parameters = new CreateContainerParameters
        // {
        //     Image = newContainer.Image.Trim(),
        //     Name = string.IsNullOrWhiteSpace(newContainer.Name) ? null : newContainer.Name.Trim(),
        //     Env = ParseEnvVars(newContainer.EnvVars),
        //     HostConfig = new HostConfig
        //     {
        //         PortBindings = ParsePortBindings(newContainer.Ports)
        //     },
        //     ExposedPorts = ParseExposedPorts(newContainer.Ports)
        // };

        // if (!string.IsNullOrWhiteSpace(newContainer.Command))
        // {
        //     parameters.Cmd = newContainer.Command.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        // }

        // var (success, message, containerId) = await DockerService.CreateContainer(server, parameters);

        // if (success && newContainer.AutoStart && containerId != null)
        // {
        //     await DockerService.StartContainer(server, containerId);
        //     ToastService.ShowSuccess("Contenedor creado e iniciado correctamente");
        // }
        // else if (success)
        // {
        //     ToastService.ShowSuccess("Contenedor creado correctamente");
        // }
        // else
        // {
        //     ToastService.ShowError(message);
        // }

        IsOnNewImage = false;
        isCreating = false;

        await RefreshImages();
        CancelNewImage();
    }

    private void CancelNewImage()
    {
        newImage = null!;
        IsOnNewImage = false;
        isCreating = false;
        StateHasChanged();
    }

    // ----------------------------------------------------------------------------------------------------------------------------------------------
    // ----------------------------------------------------------------------------------------------------------------------------------------------
    private async Task PullImage()
    {
        if (!_canWrite) 
        { 
            ToastService.ShowToast(ToastIntent.Error, "No tienes permiso para esta acción."); 
            return; 
        }

        if (server == null || string.IsNullOrWhiteSpace(pullImageName)) return;

        isPulling = true;
        StateHasChanged();

        var (success, message) = await DockerService.PullImage(server, pullImageName);

        isPulling = false;
        StateHasChanged();

        ToastService.ShowToast(success ? ToastIntent.Success : ToastIntent.Error, message);

        if (success)
        {
            pullImageName = string.Empty;
            //images = await LoadImages();
            await RefreshImages();
            CancelNewImage();
        }
    }

    private async Task DeleteImage(string imageId)
    {
        if (!_canWrite) 
        { 
            ToastService.ShowToast(ToastIntent.Error, "No tienes permiso para esta acción."); 
            return; 
        }
        if (server == null) return;
        
        // Dialogo de confirmación de borrado.
        var dlg = await DialogService.ShowConfirmationAsync($"¿Seguro que quieres borrar la imagen <strong>{ShortId(imageId)}</strong>?", "Borrar", "Cancelar", "Confirmar borrado");
        var result = await dlg.Result;
        if (result.Cancelled) return;

        var (success, message) = await DockerService.RemoveImage(server, imageId);
        ToastService.ShowToast(success ? ToastIntent.Success : ToastIntent.Error, message);
        
        if (success) {
            //images = await LoadImages();
            await RefreshImages();
        }
    }

    private static string ShortId(string id) => id.StartsWith("sha256:") ? id.Substring(7, 12) : id.Length > 12 ? id.Substring(0, 12) : id;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    // Sube un fichero .tar y lo carga en el host Docker remoto.
    private async Task OnTarSelected(InputFileChangeEventArgs e)
    {
        if (!_canWrite) { ToastService.ShowToast(ToastIntent.Error, "No tienes permiso para esta acción."); return; }
        if (server == null) return;

        var file = e.File;
        if (file == null) return;
        if (!file.Name.EndsWith(".tar", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowToast(ToastIntent.Error, "El fichero debe ser un .tar (creado con 'docker save').");
            return;
        }

        isLoadingTar = true;
        StateHasChanged();

        // Guardamos el fichero subido en un temporal del servidor y desde ahí lo enviamos
        // por streaming al Docker remoto. El temporal se borra siempre al terminar.
        var tempPath = Path.GetTempFileName();
        try
        {
            const long maxSize = 2L * 1024 * 1024 * 1024; // 2 GB máximo

            await using (var destino = File.Create(tempPath))
            {
                await file.OpenReadStream(maxSize).CopyToAsync(destino);
            }

            await using (var tar = File.OpenRead(tempPath))
            {
                var (success, message) = await DockerService.LoadImage(server, tar);
                ToastService.ShowToast(success ? ToastIntent.Success : ToastIntent.Error, message);
                if (success)
                {
                    //images = await LoadImages();
                    await RefreshImages();
                    CancelNewImage();
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(ToastIntent.Error, $"Error al subir el fichero: {ex.Message}");
        }
        finally
        {
            if (File.Exists(tempPath)) File.Delete(tempPath);
            isLoadingTar = false;
            StateHasChanged();
        }
    }
}
