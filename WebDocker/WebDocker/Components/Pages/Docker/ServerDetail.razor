    }

    private async Task RemoveContainer(string containerId, string containerName)
    {
        if (!_canContainersWrite) { ToastService.ShowError("No tienes permiso para esta acción."); return; }
        if (server == null) return;

        // Dialogo de confirmación de borrado.
        var dlg = await DialogService.ShowConfirmationAsync($"¿Seguro que quieres borrar el contenedor <strong>{containerName}</strong>?", "Borrar", "Cancelar", "Confirmar borrado");
        var result = await dlg.Result;
        if (result.Cancelled) return;

        var (success, message) = await DockerService.RemoveContainer(server, containerId);
        if (success)
            ToastService.ShowSuccess($"Contenedor '{containerName}' eliminado");
        else
            ToastService.ShowError(message);
        await RefreshContainers();
    }


