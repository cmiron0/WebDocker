    private static string GetContainerName(ContainerListResponse c) => c.Names?.FirstOrDefault()?.TrimStart('/') ?? c.ID[..12];

    private static string FormatDate(DateTime dt) => dt > DateTime.MinValue ? dt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-";
    private static string FormatDateAt(string date) 
    {
        if (!DateTimeOffset.TryParse(date, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var dto) || dto.Year <= 1)
            return "—";
        return FormatDate(dto.Date);
    }

    private static Appearance GetStateAppearance(string state)
    {
        switch (state) {
            case "running": return Appearance.Accent;
            case "exited": return Appearance.Lightweight;
            case "paused": return Appearance.Neutral;
            default: return Appearance.Lightweight;
        }
    }

    private static string GetStateBadgeStyle(string state)
    {
        switch (state) {
            case "running": return "background:#d4edda; color:#155724;";
            case "exited": return "background:#f8d7da; color:#721c24;";
            case "paused": return "background:#fff3cd; color:#856404;";
            default : return "";
        }
    }




