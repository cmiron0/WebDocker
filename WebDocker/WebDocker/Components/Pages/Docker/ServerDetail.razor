    private ContainerInspectResponse? containerDetails;
    private string? detailsContainerName;
    private bool isLoadingDetails = false;

    private async Task ShowContainerDetail(string containerId, string containerName)
    {
        if (server == null) return;

        isLoadingDetails = true;
        StateHasChanged();

        detailsContainerName = containerName;
        containerDetails = null;

        // Detalles del contenedor
        containerDetails = await DockerService.GetContainerDetails(server, containerId);

        isLoadingDetails = false;
        StateHasChanged();
    }

    private void CloseDetails()
    {
        containerDetails = null;
        StateHasChanged();
    }


