    private async Task StartContainer(string containerId)
    {
        if (!_canContainersWrite) { ToastService.ShowError("No tienes permiso para esta acción."); return; }
        if (server == null) return;
        var (success, message) = await DockerService.StartContainer(server, containerId);
        ToastService.ShowInfo(success ? "Contenedor iniciado" : message);
        await RefreshContainers();
    }

