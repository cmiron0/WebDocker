    private async Task UnpauseContainer(string containerId)
    {
        if (!_canContainersWrite) { ToastService.ShowError("No tienes permiso para esta acción."); return; }
        if (server == null) return;
        var (success, message) = await DockerService.UnPauseContainer(server, containerId);
