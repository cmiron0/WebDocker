@using Microsoft.FluentUI.AspNetCore.Components

@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar" style="width:290px!important;">
        <NavMenu />
    </div>

    <main class="main">
        <div class="top-row px-4 auth rounded-main">
            <div class="me-auto"></div>
            <NavActionLogin />
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="menu-row px-4 auth rounded-main">
                    <div class="me-auto"></div>
                        @*                        <ul class="navbar-nav" >
                            <li class="nav-item">
                                <span class="nav-link text-dark"> <strong></strong></span>
                            </li>
                        </ul>
                    </div> *@
                    <NavActionMenu />
                </div>
            </Authorized>
            <NotAuthorized>

            </NotAuthorized>
        </AuthorizeView>


        <article class="content px-2">
            @Body
        </article>

        <footer>
            <div>
                © 2026 WebDocker - v1.0.0
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<FluentToastProvider @rendermode="InteractiveServer" />
<FluentDialogProvider @rendermode="InteractiveServer" />
<FluentTooltipProvider @rendermode="InteractiveServer" />
<FluentMessageBarProvider @rendermode="InteractiveServer" />
<FluentMenuProvider @rendermode="InteractiveServer" />

